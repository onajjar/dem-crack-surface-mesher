examples/deap/*/results/headless-run-report.json
examples/deap/*/results/_previous_mesh_runs/
examples/characterization/*/generated_output/

# Large reviewed MATLAB analysis archive remains local; track its audit only.
legacy/matlab/Crack_Analysis_MATLAB/*

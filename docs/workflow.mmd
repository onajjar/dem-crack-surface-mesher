flowchart LR
    DEAP["Raw DEAP results<br/>deap_post.h5 · deap_output.h5"] --> FIT["Python quadratic LOESS<br/>MATLAB-compatible surface"]
    FIT --> SOURCE
    GUI --> DECISION{"Advanced characterization?"}
    DECISION -->|yes| CHARACTER["Python characterization<br/>aperture · geometrical tortuosity<br/>roughness/Hurst · cubic-law proxies"]
    CHARACTER --> REPORT["JSON/CSV report · figures<br/>optional synthetic four-CSV surface"]
    DECISION -->|bypass| DGIBI
    CHARACTER --> DGIBI
    SOURCE["Surface source<br/>CSV · fitted DEAP · self-affine fractal<br/>constant Z planes"] --> CONTRACT["Canonical matrices<br/>xrange · yrange<br/>zfit_zmin · zfit_zmax"]
    CONTRACT --> GUI["Scientific launcher<br/>GUI or headless<br/>validation · naming"]
    TEMPLATE["Preserved templates<br/>castem_tool.dgibi<br/>fuite_fissure.dgibi"] --> GUI
    GUI --> DGIBI["Patched DGIBI<br/>run-specific values"]
    CONTRACT --> CASTEM["Cast3M 25<br/>geometry processing<br/>mesh generation"]
    DGIBI --> CASTEM
    CASTEM --> MESH["Mesh outputs<br/>volume BDF<br/>surface BDF files"]
    MESH --> CFD["Combined NASTRAN BDF<br/>volume + named surfaces<br/>for downstream CFD import"]

    GUI -. optional .-> FSETUP["Optional FISS setup<br/>model · gas · boundary conditions<br/>pressure / temperature"]
    CONTRACT -.-> FSETUP
    FSETUP -.-> FISS["Cast3M FISS<br/>flow calculation<br/>along crack lines"]
    FISS -.-> RESULTS["Flow results<br/>profiles · totals<br/>optional post-processing"]

